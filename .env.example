# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---- Backend / database (server/, added -- see README "Backend & Database") ----

# PORT: port the Express backend listens on. The React app calls it via
# fetch, and the ESP32 device POSTs its readings to it.
PORT=4000

# TURSO_DATABASE_URL / TURSO_AUTH_TOKEN: your Turso (libSQL) database.
# Create a free database at https://turso.tech, then:
#   turso db create cocosense
#   turso db show cocosense --url          -> TURSO_DATABASE_URL
#   turso db tokens create cocosense       -> TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token


# DEVICE_API_KEY: must match the `apiKey` constant in the ESP32 sketch.
# Change both together if you rotate it.
DEVICE_API_KEY=replace-with-your-own-device-api-key

# GRAMS_ELEVATED / GRAMS_CRITICAL: grams thresholds used to bucket a
# reading's severity. Placeholder values -- tune against real impacts.
GRAMS_ELEVATED=1.5
GRAMS_CRITICAL=5.0

# BACKUP_FIELD_KEY: 32-byte (64 hex char) key used to encrypt farm
# owners' PII (name/email/phone/address/geo_coordinates) inside
# "Export System Backup" downloads, so the .json file is unreadable to
# anyone who opens it without this key -- see server/fieldCrypto.js.
# Required before Export/Restore will work. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Treat it like TURSO_AUTH_TOKEN: never commit it, and back it up
# somewhere safe -- losing it makes existing encrypted backups
# permanently unrestorable.
BACKUP_FIELD_KEY=replace-with-a-generated-64-char-hex-key

# ---- Gmail SMTP (for real welcome-credential emails) ----
# Without these two set, the server still logs every email to the
# Outbox (visible in-app) but does NOT actually send it -- useful for
# development without needing real credentials.
#
# Gmail requires an "App Password", not your normal login password:
#   Google Account -> Security -> 2-Step Verification (turn ON) ->
#   App Passwords -> generate one for "Mail" -> paste the 16-char value
#   below (spaces don't matter).
GMAIL_USER=your-address@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# OWNER_PORTAL_URL: base URL of the frontend's owner portal, used to
# build the account-confirmation link sent in the owner welcome email
# (e.g. "<OWNER_PORTAL_URL>/owner/confirm?token=..."). Defaults to
# http://localhost:3000 (the Vite dev server) if unset -- change this
# to your real domain before deploying.
# OWNER_PORTAL_URL=http://localhost:3000
