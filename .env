# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---- Backend / database (server/, added -- see README "Backend & Database") ----

# PORT: port the Express backend listens on. The React app calls it via
# fetch, and the ESP32 device POSTs its readings to it.
PORT=4000

# DB_PATH: where the SQLite database file lives. Defaults to
# server/data/cocosense.db if unset -- only set this to point somewhere else.
# DB_PATH=server/data/cocosense.db
#
# Leave TURSO_DATABASE_URL unset to use a local SQLite file
# (server/data/cocosense.db) -- no account or network needed, this is
# what makes the app run fully on localhost. Uncomment the two lines
# below (your original cloud DB) if you want to point at Turso instead.
# TURSO_DATABASE_URL=libsql://cocosense-cocosense.aws-ap-northeast-1.turso.io
# TURSO_AUTH_TOKEN=eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9.eyJhIjoicnciLCJpYXQiOjE3ODgzNjQxNjEsImlkIjoiMDFhMDYyY2QtZDQwMS03ZWM0LWIxMmQtMzI5YjZhMzNhMzBiIiwia2lkIjoiRlRpQng4ZnNtc01lTks5VElhLUNTZm9HZE5QWERwODQ1cG5qQkhnME1NYyIsInJpZCI6IjBkYTA1OWZkLTM2YTYtNDI1YS04Y2YxLTljZGIxNzk2OWVhOSJ9.GYyarfhnmDED-YrjjPDXIteSvK2Tu-uMk1KGK0nDcEERmybI7SBZHIAvfkaRM3Fl3SdWiYi-PJqy4QeYH_tBDw
# DEVICE_API_KEY: must match the `apiKey` constant in the ESP32 sketch
# (currently "Luna-1327"). Change both together if you rotate it.
DEVICE_API_KEY=Luna-1327

# GRAMS_ELEVATED / GRAMS_CRITICAL: grams thresholds used to bucket a
# reading's severity. Placeholder values -- tune against real impacts.
GRAMS_ELEVATED=1.5
GRAMS_CRITICAL=5.0

# ---- Gmail SMTP (for real welcome-credential emails) ----
# Without these two set, the server still logs every email to the
# Outbox (visible in-app) but does NOT actually send it -- useful for
# development without needing real credentials.
#
# Gmail requires an "App Password", not your normal login password:
#   Google Account -> Security -> 2-Step Verification (turn ON) ->
#   App Passwords -> generate one for "Mail" -> paste the 16-char value
#   below (spaces don't matter).
GMAIL_USER=cocosense2026@gmail.com
GMAIL_APP_PASSWORD=csvb auxk qfal ntkp
# OWNER_PORTAL_URL: base URL of the frontend's owner portal, used to
# build the account-confirmation link sent in the owner welcome email
# (e.g. "<OWNER_PORTAL_URL>/owner/confirm?token=..."). Defaults to
# http://localhost:3000 (the Vite dev server) if unset -- change this
# to your real domain before deploying.
# OWNER_PORTAL_URL=http://localhost:3000

# BACKUP_FIELD_KEY: encrypts farm owners' PII inside exported system
# backups (server/fieldCrypto.js). Keep this secret, back it up
# somewhere safe -- losing it makes existing encrypted backups
# permanently unrestorable.
BACKUP_FIELD_KEY=ed1c6d8565684104925c2ad0c1760c09804882c811e4e670b56b4f0a04f2849a
